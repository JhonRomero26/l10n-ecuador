<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ec_ote_canton_list" model="ir.ui.view">
        <field name="name">l10n_ec_ote.canton.list</field>
        <field name="model">l10n_ec_ote.canton</field>
        <field name="arch" type="xml">
            <list string="Cantones" create="0" delete="0">
                <header>
                    <button
                        name="%(action_l10n_ec_ote_canton_wizard)d"
                        type="action"
                        string="Nuevo Cantón"
                        class="btn-primary"
                    />
                </header>
                <field name="code" />
                <field name="name" />
                <field name="state_id" />
            </list>
        </field>
    </record>

    <record id="view_l10n_ec_ote_canton_form" model="ir.ui.view">
        <field name="name">l10n_ec_ote.canton.form</field>
        <field name="model">l10n_ec_ote.canton</field>
        <field name="arch" type="xml">
            <form string="Cantón" create="0" delete="0">
                <header>
                    <button
                        name="%(action_l10n_ec_ote_canton_wizard)d"
                        type="action"
                        string="Nuevo Cantón"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="country_id" string="País" readonly="1" />
                        <field name="state_id" string="Provincia" />
                        <field name="name" />
                        <field name="code" string="Código" />
                    </group>
                    <notebook>
                        <page string="Parroquias">
                            <field name="parish_ids" delete="0">
                                <list delete="0">
                                    <field name="code" string="Código" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ec_ote_canton" model="ir.actions.act_window">
        <field name="name">Cantones</field>
        <field name="res_model">l10n_ec_ote.canton</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p
                class="o_view_nocontent_smiling_face"
            >Cree y mantenga los cantones de Ecuador.</p>
            <p
            >Use el botón Nuevo Cantón para generar el siguiente código disponible por provincia.</p>
        </field>
    </record>

    <record id="view_l10n_ec_ote_parish_list" model="ir.ui.view">
        <field name="name">l10n_ec_ote.parish.list</field>
        <field name="model">l10n_ec_ote.parish</field>
        <field name="arch" type="xml">
            <list string="Parroquias" create="0" delete="0">
                <header>
                    <button
                        name="%(action_l10n_ec_ote_parish_wizard)d"
                        type="action"
                        string="Nueva Parroquia"
                        class="btn-primary"
                    />
                </header>
                <field name="code" />
                <field name="name" />
                <field name="state_id" />
                <field name="canton_id" />
            </list>
        </field>
    </record>

    <record id="view_l10n_ec_ote_parish_form" model="ir.ui.view">
        <field name="name">l10n_ec_ote.parish.form</field>
        <field name="model">l10n_ec_ote.parish</field>
        <field name="arch" type="xml">
            <form string="Parroquia" create="0" delete="0">
                <header>
                    <button
                        name="%(action_l10n_ec_ote_parish_wizard)d"
                        type="action"
                        string="Nueva Parroquia"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="country_id" string="País" readonly="1" />
                        <field name="state_id" string="Provincia" readonly="1" />
                        <field name="canton_id" />
                        <field name="name" />
                        <field name="code" string="Código" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ec_ote_parish" model="ir.actions.act_window">
        <field name="name">Parroquias</field>
        <field name="res_model">l10n_ec_ote.parish</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p
                class="o_view_nocontent_smiling_face"
            >Cree y mantenga las parroquias de Ecuador.</p>
            <p
            >Use el botón Nueva Parroquia para generar el siguiente código urbano o rural dentro del cantón.</p>
        </field>
    </record>

    <menuitem
        id="menu_l10n_ec_ote_canton"
        name="Cantones"
        parent="contacts.menu_localisation"
        action="action_l10n_ec_ote_canton"
        sequence="10"
        groups="base.group_system"
    />

    <menuitem
        id="menu_l10n_ec_ote_parish"
        name="Parroquias"
        parent="contacts.menu_localisation"
        action="action_l10n_ec_ote_parish"
        sequence="11"
        groups="base.group_system"
    />
</odoo>
