#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Cantons can only be created for Ecuadorian provinces."
msgstr "Los cantones solo se pueden crear para provincias ecuatorianas."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "The canton code must contain exactly 4 digits."
msgstr "El código del cantón debe tener exactamente 4 dígitos."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "The canton code must start with the province code %(prefix)s."
msgstr "El código del cantón debe empezar con el código de provincia %(prefix)s."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Province %(state)s must have a 2 digit numeric code."
msgstr "La provincia %(state)s debe tener un código numérico de 2 dígitos."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Province %(state)s has no remaining canton codes."
msgstr "La provincia %(state)s no tiene códigos de cantón disponibles."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Parishes can only be created for Ecuadorian cantons."
msgstr "Las parroquias solo se pueden crear para cantones ecuatorianos."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "The parish code must contain exactly 6 digits."
msgstr "El código de la parroquia debe tener exactamente 6 dígitos."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "The parish code must start with the canton code %(prefix)s."
msgstr "El código de la parroquia debe empezar con el código de cantón %(prefix)s."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Parish type must be either urban or rural."
msgstr "El tipo de parroquia debe ser urbano o rural."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Canton %(canton)s has no remaining urban parish codes."
msgstr "El cantón %(canton)s no tiene códigos disponibles para parroquias urbanas."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/models/l10n_ec_ote.py:0
msgid "Canton %(canton)s has no remaining rural parish codes."
msgstr "El cantón %(canton)s no tiene códigos disponibles para parroquias rurales."

#. module: l10n_ec_ote
#. odoo-python
#: code:addons/l10n_ec_ote/wizards/location_wizard.py:0
msgid "Only Ecuadorian provinces are allowed."
msgstr "Solo se permiten provincias ecuatorianas."

#. module: l10n_ec_ote
#: model:ir.model.fields,help:l10n_ec_ote.field_res_partner__partner_country_code
#: model:ir.model.fields,help:l10n_ec_ote.field_res_users__partner_country_code
msgid ""
"The ISO country code in two chars. \n"
"You can use this field for quick search."
msgstr ""
"El código ISO de país en dos caracteres. \n"
"Puede usar este campo para una búsqueda rápida."

