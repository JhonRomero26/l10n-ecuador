"    <t t-set=\"invoice_total_amount\" t-value=\"abs(sum(related_invoices.mapped('amount_total')))\"/>\n"
"    <t t-set=\"invoice_net_amount\" t-value=\"abs(sum(related_invoices.mapped('amount_residual')))\"/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Dear\n"
"        <t t-if=\"object.partner_id.parent_id\">\n"
"            <t t-out=\"object.partner_id.name or ''\"/> (<t t-out=\"object.partner_id.parent_id.name or ''\"/>),\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"object.partner_id.name or ''\"/>,\n"
"        </t>\n"
"        <br/><br/>\n"
"        Attached is your withholding certificate\n"
"        <t t-if=\"object.name\">\n"
"            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"/>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            with no reference\n"
"        </t>\n"
"        <t t-if=\"related_invoices\">\n"
"            , corresponding to invoice\n"
"            <span style=\"font-weight:bold;\" t-out=\"', '.join(related_invoices.mapped('name'))\"/>\n"
"            issued by <t t-out=\"object.company_id.name or ''\"/>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            issued by <t t-out=\"object.company_id.name or ''\"/>.\n"
"        </t>\n"
"        <br/><br/>\n"
"        Summary:\n"
"        <br/>- Invoice total:\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(invoice_total_amount, object.currency_id) or ''\"/>\n"
"        <br/>- Amount withheld:\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(withhold_amount, object.currency_id) or ''\"/>\n"
"        <br/>- Net amount payable:\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(invoice_net_amount, object.currency_id) or ''\"/>\n"
"        <br/><br/>\n"
"        Contact us if you have any questions.\n"
"        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\">\n"
"            <br/><br/>\n"
"            <t t-out=\"object.invoice_user_id.signature or ''\"/>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <t t-set=\"withhold_amount\" t-value=\"sum(object.l10n_ec_withhold_line_ids.mapped('l10n_ec_withhold_tax_amount'))\"/>\n"
"    <t t-set=\"related_invoices\" t-value=\"object.line_ids.mapped('l10n_ec_invoice_withhold_id')\"/>\n"
"    <t t-set=\"invoice_total_amount\" t-value=\"abs(sum(related_invoices.mapped('amount_total')))\"/>\n"
"    <t t-set=\"invoice_net_amount\" t-value=\"abs(sum(related_invoices.mapped('amount_residual')))\"/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Apreciable\n"
"        <t t-if=\"object.partner_id.parent_id\">\n"
"            <t t-out=\"object.partner_id.name or ''\"/> (<t t-out=\"object.partner_id.parent_id.name or ''\"/>),\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            <t t-out=\"object.partner_id.name or ''\"/>,\n"
"        </t>\n"
"        <br/><br/>\n"
"        Adjuntamos tu comprobante de retención\n"
"        <t t-if=\"object.name\">\n"
"            <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"/>\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            sin referencia\n"
"        </t>\n"
"        <t t-if=\"related_invoices\">\n"
"            , correspondiente a la factura\n"
"            <span style=\"font-weight:bold;\" t-out=\"', '.join(related_invoices.mapped('name'))\"/>\n"
"            emitida por <t t-out=\"object.company_id.name or ''\"/>.\n"
"        </t>\n"
"        <t t-else=\"\">\n"
"            emitido por <t t-out=\"object.company_id.name or ''\"/>.\n"
"        </t>\n"
"        <br/><br/>\n"
"        Resumen:\n"
"        <br/>- Total de la factura:\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(invoice_total_amount, object.currency_id) or ''\"/>\n"
"        <br/>- Valor retenido:\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(withhold_amount, object.currency_id) or ''\"/>\n"
"        <br/>- Valor neto a pagar:\n"
"        <span style=\"font-weight:bold;\" t-out=\"format_amount(invoice_net_amount, object.currency_id) or ''\"/>\n"
"        <br/><br/>\n"
"        Contáctanos si tienes alguna pregunta.\n"
"        <t t-if=\"not is_html_empty(object.invoice_user_id.signature)\">\n"
"            <br/><br/>\n"
"            <t t-out=\"object.invoice_user_id.signature or ''\"/>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"

